# Copy this file to .env and fill in real values. Never commit .env.

# --- Nuvei sandbox credentials ---
NUVEI_MERCHANT_ID=
NUVEI_MERCHANT_SITE_ID=
NUVEI_SECRET_KEY=
NUVEI_ENV=sandbox

# --- Admin back office passcode (gates /admin) ---
ADMIN_PASSCODE=

# --- Public app URL (used to build the Nuvei DMN webhook URL) ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Vercel-managed Upstash Redis (populate via `vercel env pull .env.local` after provisioning) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Optional: Gemini API key for Nano Banana image generation (scripts/generate-images.js) ---
# If unset, the image script falls back to generated SVG placeholders.
GEMINI_API_KEY=
